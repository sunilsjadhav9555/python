   "source": [
    "9.Write a python code using a for loop and break to find the first non-repeating\n",
    "character in a string.\n",
    "a. Input=people\n",
    "b. Output=o"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "6a8b26b4-5bb4-46f6-9ea5-104cb5c70b3c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "o\n"
     ]
    }
   ],
   "source": [
    "text = \"people\" \n",
    "\n",
    "for item in text:\n",
    "    if text.count(item) == 1:\n",
    "        print(item)\n",
    "        break"
   ]
  },
